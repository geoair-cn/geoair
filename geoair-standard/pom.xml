<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>cn.geoair.devkit</groupId>
    <artifactId>geoair-base-parent</artifactId>
    <version>J8.1.1</version>
    <relativePath>../geoair-base-parent/pom.xml</relativePath>
  </parent>

  <groupId>cn.geoair.devkit</groupId>
  <artifactId>geoair-standard</artifactId>
  <version>J8.1.1</version>
  <packaging>pom</packaging>
  <name>geoair-standard</name>

  <description>基础标准库，设计初衷是通过spi实现相关常用的工具</description>

  <url>https://github.com/geoair-cn/geoair</url>

  <licenses>
    <license>
      <name>The Apache Software License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>zhangfengji</name>
      <email>1159856928@qq.com</email>
      <organization>geoair</organization>
      <organizationUrl>https://xmt.geoair.cn/</organizationUrl>
    </developer>
  </developers>
  <modules>

    <module>geoair-tools</module>
    <module>geoair-base</module>
    <module>geoair-web</module>
    <module>geoair-core</module>
    <module>geoair-orm</module>
    <module>geoair-sdk</module>

  </modules>

  <scm>
    <connection>scm:git://github.com/geoair-cn/geoair.git</connection>
    <developerConnection>scm:git:https://github.com:geoair-cn/geoair.git</developerConnection>
    <tag>HEAD</tag>
    <url>https://github.com/geoair-cn/geoair</url>
  </scm>

  <properties>
    <geoair.version>J8.1.1</geoair.version>
    <skipTests>true</skipTests>
  </properties>

  <dependencyManagement>
    <dependencies>

      <!-- gir版本约束 -->
      <dependency>
        <groupId>cn.geoair.devkit</groupId>
        <artifactId>geoair-base</artifactId>
        <version>${geoair.version}</version>
      </dependency>

      <dependency>
        <groupId>cn.geoair.devkit</groupId>
        <artifactId>geoair-web</artifactId>
        <version>${geoair.version}</version>
      </dependency>

      <dependency>
        <groupId>cn.geoair.devkit</groupId>
        <artifactId>geoair-tools</artifactId>
        <version>${geoair.version}</version>
      </dependency>

      <dependency>
        <groupId>cn.geoair.devkit</groupId>
        <artifactId>geoair-core</artifactId>
        <version>${geoair.version}</version>
      </dependency>

      <dependency>
        <groupId>cn.geoair.devkit</groupId>
        <artifactId>geoair-sdk</artifactId>
        <version>${geoair.version}</version>
      </dependency>

      <dependency>
        <groupId>cn.geoair.devkit</groupId>
        <artifactId>geoair-orm-mybatis</artifactId>
        <version>${geoair.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.geoair.devkit</groupId>
        <artifactId>geoair-orm-base</artifactId>
        <version>${geoair.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.geoair.devkit</groupId>
        <artifactId>geoair-orm-mybatis-tk</artifactId>
        <version>${geoair.version}</version>
      </dependency>

      <dependency>
        <groupId>cn.geoair.devkit</groupId>
        <artifactId>geoair-orm-mybatis-plus</artifactId>
        <version>${geoair.version}</version>
      </dependency>

      <dependency>
        <groupId>cn.geoair.devkit</groupId>
        <artifactId>geoair-orm-springjpa</artifactId>
        <version>${geoair.version}</version>
      </dependency>

      <dependency>
        <groupId>cn.geoair.devkit</groupId>
        <artifactId>geoair-orm-spi</artifactId>
        <version>${geoair.version}</version>
      </dependency>
      <!-- soa -->

    </dependencies>
  </dependencyManagement>
  <dependencies></dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>${maven-jar-plugin.version}</version>
        <configuration>
          <!--					<classifier>bak</classifier>-->
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <parameters>true</parameters>
          <!-- 源码版本 -->
          <source>8</source>
          <!-- 目标字节码版本 -->
          <target>8</target>
          <!-- 编码（可选，避免中文乱码） -->
          <encoding>UTF-8</encoding>
        </configuration>
      </plugin>

      <!--生成源码插件-->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--生成API文档插件-->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>${maven-javadoc-plugin.version}</version>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <!-- 打包 javadoc.jar -->
              <goal>jar</goal>
              <!-- 编译时自动修复注释 -->
              <goal>fix</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <!-- 自动修复类注释 -->
          <fixClassComment>true</fixClassComment>
          <!-- 自动修复方法注释 -->
          <fixMethodComment>true</fixMethodComment>
          <!-- 自动修复字段注释 -->
          <fixFieldComment>true</fixFieldComment>
          <version>false</version>
          <author>false</author>
          <!-- 开启严格模式，注释不规范直接报错 -->
          <failOnError>false</failOnError>
          <!-- 文档编码 UTF-8 -->
          <encoding>UTF-8</encoding>

        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
