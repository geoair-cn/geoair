package ${packageName}.service.${moduleName};

import cn.geoair.base.log.GiLogger;
import cn.geoair.base.log.GirLogger;
import cn.geoair.base.data.page.GiPageParam;
import cn.geoair.base.data.page.GiPager;
import cn.geoair.base.util.GutilObject;
import cn.hutool.core.util.ArrayUtil;
import cn.hutool.core.util.ReflectUtil;
import ${packageName}.dao.${moduleName}.${ClassName}Dao;
import ${packageName}.model.${moduleName}.dto.${ClassName}Dto;
import ${packageName}.model.${moduleName}.entity.${ClassName}Po;
import ${packageName}.model.${moduleName}.seo.${ClassName}Seo;
import ${packageName}.servface.${moduleName}.${ClassName}Service;
import ${packageName}.servface.${moduleName}.event.${ClassName}Event;
    #if(${enableCache})
    import org.springframework.cache.annotation.CacheConfig;
    import org.springframework.cache.annotation.CacheEvict;
    import org.springframework.cache.annotation.Cacheable;
    #end
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import javax.annotation.Resource;
import java.util.*;

/**
 * ${tableComment}Service业务层处理
 *
 * @author ${author}
 * @date ${datetime}
 */
@Service
    #if(${enableCache})
    @CacheConfig(cacheNames = "${className}")
    #end
@Transactional(rollbackFor = Exception.class)
public class ${ClassName}ServiceImpl implements ${ClassName}Service {
    private static final GiLogger log = GirLogger.getLoger(${ClassName}ServiceImpl.class);
    @Resource
    private ${ClassName}Dao ${className}Dao;

    @Override
        #if(${enableCache})
        @CacheEvict(key = "'list'", allEntries = true)
        #end
    public ${ClassName}Po add(${ClassName}Po po) {
        // 初始化创建元数据
        po.initCreateMeta();
        // 插入数据
            ${className}Dao.gtcAccessSelective(po);
        // 触发新增事件
        triggerAddEvent(po);
        return po;
    }

    @Override
        #if(${enableCache})
        @CacheEvict(key = "#po.id()")
        #end
    public ${ClassName}Po update(${ClassName}Po po) {
        // 获取原对象
            ${ClassName}Po oldPo = ${className}Dao.gtcSearchByPK(po.id());
        if (oldPo == null) {
            throw new RuntimeException("数据不存在，ID：" + po.id());
        }
        // 初始化更新元数据
        po.initUpdateMeta();
        // 触发更新事件
        triggerUpdateEvent(oldPo, po);
        // 更新数据
            ${className}Dao.gtcUpdateByPKSelective(po);
        return po;
    }

    @Override
        #if(${enableCache})
        @CacheEvict(key = "#id")
        #end
    public void deleteById(String id) {
        // 获取原对象
            ${ClassName}Po po = ${className}Dao.gtcSearchByPK(id);
        if (po == null) {
            return;
        }
        // 触发删除事件
        triggerDeleteEvent(po);
        // 物理删除
            ${className}Dao.gtcDeleteByPK(id);
    }

    @Override
        #if(${enableCache})
        @CacheEvict(key = "#id")
        #end
    public void logicDeleteById(String id) {
        // 获取原对象
            ${ClassName}Po po = ${className}Dao.gtcSearchByPK(id);
        if (po == null) {
            return;
        }
        // 触发删除事件
        triggerDeleteEvent(po);
        // 逻辑删除
        po.setDel();
            ${className}Dao.gtcUpdateByPKSelective(po);
    }

    @Override
        #if(${enableCache})
        @Cacheable(key = "#id", unless = "#result == null")
        #end
    public ${ClassName}Dto getDtoById(String id) {
            ${ClassName}Po po = ${className}Dao.gtcSearchByPK(id);
        return po != null ? ${ClassName}Dto.of${ClassName}Po(po) : null;
    }

    @Override
    public ${ClassName}Po getPoById(String id) {
        return ${className}Dao.gtcSearchByPK(id);
    }

    @Override
    public List<${ClassName}Dto> getDtoListBySeo(${ClassName}Seo seo) {
        seo.setNotDel();
        return ${className}Dao.searchList(seo);
    }

    @Override
    public GiPager<${ClassName}Dto> getDtoPageBySeo(${ClassName}Seo seo, GiPageParam pageParam) {
        seo.setNotDel();
        return ${className}Dao.searchListPage(seo, pageParam);
    }

    @Override
    public List<${ClassName}Po> getPoListBySeo(${ClassName}Seo seo) {
        seo.setNotDel();
        return ${className}Dao.gtcSearch(seo);
    }

    @Override
    public <T> Map<String, ${ClassName}Dto> getDtoMapByField(List<T> beanList, String fieldName) {
        Map<String, ${ClassName}Dto> resultMap = new HashMap<>();
        if (GutilObject.isEmpty(beanList)) {
            return resultMap;
        }
        // 收集字段值
        Set<String> fieldValues = new HashSet<>();
        for (T bean : beanList) {
            Object value = ReflectUtil.getFieldValue(bean, fieldName);
            if (value instanceof String) {
                fieldValues.add((String) value);
            }
        }
        if (fieldValues.isEmpty()) {
            return resultMap;
        }
        // 查询数据
            ${ClassName}Seo seo = new ${ClassName}Seo();
        seo.setNotDel();
        seo.setAndIdsIn(ArrayUtil.toArray(fieldValues, String.class));
        List<${ClassName}Dto> dtos = ${className}Dao.searchList(seo);
        for (${ClassName}Dto dto : dtos) {
            resultMap.put(dto.getId(), dto);
        }
        return resultMap;
    }

    @Override
        #if(${enableCache})
        @CacheEvict(allEntries = true)
        #end
    public void refreshCache() {
        #if(${enableCache})
            log.info("刷新缓存：{}", "${className}");
        #else
            // 缓存已禁用，无需刷新
            log.debug("缓存已禁用，跳过刷新：{}", "${className}");
        #end
    }


    /**
     * 触发新增事件
     */
    private void triggerAddEvent(${ClassName}Po po) {
        List<${ClassName}Event> events = ${ClassName}Event.getInstances();
        for (${ClassName}Event event : events) {
            try {
                event.add${ClassName}Event(po);
            } catch (Exception e) {
                log.error("触发新增事件失败", e);
            }
        }
    }

    /**
     * 触发更新事件
     */
    private void triggerUpdateEvent(${ClassName}Po oldPo, ${ClassName}Po newPo) {
        List<${ClassName}Event> events = ${ClassName}Event.getInstances();
        for (${ClassName}Event event : events) {
            try {
                event.update${ClassName}Event(oldPo, newPo);
            } catch (Exception e) {
                log.error("触发更新事件失败", e);
            }
        }
    }

    /**
     * 触发删除事件
     */
    private void triggerDeleteEvent(${ClassName}Po po) {
        List<${ClassName}Event> events = ${ClassName}Event.getInstances();
        for (${ClassName}Event event : events) {
            try {
                event.del${ClassName}Event(po);
            } catch (Exception e) {
                log.error("触发删除事件失败", e);
            }
        }
    }
}
