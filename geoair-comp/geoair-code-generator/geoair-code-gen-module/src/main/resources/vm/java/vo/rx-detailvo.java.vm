package ${packageName}.controller.${moduleName}.${classname};

import com.alibaba.fastjson.annotation.JSONField;
import cn.hutool.core.collection.ListUtil;
import cn.geoair.base.util.GutilObject;
import org.springframework.beans.BeanUtils;
import cn.geoair.base.data.model.annotation.GaModel;
import cn.geoair.base.data.model.annotation.GaModelField;
import ${packageName}.model.${moduleName}.dto.${ClassName}Dto;
import ${packageName}.model.${moduleName}.entity.${ClassName}Po;
import org.springframework.format.annotation.DateTimeFormat;
import javax.validation.constraints.NotBlank;
import com.fasterxml.jackson.annotation.JsonFormat;
import lombok.Data;
import java.util.List;

#foreach ($column in $columns)
    #if("$!{column.enumsName}" != "")
    import ${packageName}.model.${moduleName}.enm.${column.enumsName};
    #end
#end

/**
 * ${tableComment}对象 ${tableName}
 *
 * @author ${author}
 * @date ${datetime}
 */
@Data
@GaModel(text = "删除${tableComment}")
public class ${ClassName}DetailVo {

    #foreach($column in $columns)
        #* 主键列：必填 + ID注解 *#
        #if($column.isPk==1)
        @NotBlank(message = "${column.columnComment} 不能为空")
        @GaModelField(text = "${column.columnComment}",isID=true)
        #else
            #* 日期类型：格式化注解 + 基础字段注解 *#
            #if($column.javaType=='Date')
            @JSONField(format = "yyyy-MM-dd HH:mm:ss")
            @DateTimeFormat(pattern = "yyyy-MM-dd HH:mm:ss")
            @JsonFormat(pattern = "yyyy-MM-dd HH:mm:ss")
            @GaModelField(text = "${column.columnComment}")
            #else
                #* 枚举列：枚举注解 *#
                #if("$!{column.enumsName}" != "")
                @GaModelField(text = "${column.columnComment}",em = ${column.enumsName}.class)
                #else
                    #* 普通列：基础字段注解 *#
                @GaModelField(text = "${column.columnComment}")
                #end
            #end
        #end
    private ${column.javaType} ${column.javaField};
    #end


    public static ${ClassName}DetailVo fromDto(${ClassName}Dto dto) {
            ${ClassName}DetailVo vo = new ${ClassName}DetailVo();
        BeanUtils.copyProperties(dto, vo);
        return vo;
    }

    public static ${ClassName}DetailVo fromPo(${ClassName}Po po) {
            ${ClassName}DetailVo vo = new ${ClassName}DetailVo();
        BeanUtils.copyProperties(po, vo);
        return vo;
    }

    public static List<${ClassName}DetailVo> fromDtos(Iterable<${ClassName}Dto> dtos) {
        if (GutilObject.isNotEmpty(dtos)) {
            List<${ClassName}DetailVo> list = ListUtil.list(false);
            for (${ClassName}Dto dto : dtos) {
                list.add(fromDto(dto));
            }
            return list;
        }
        return ListUtil.empty();
    }

    public static List<${ClassName}DetailVo> fromPos(Iterable<${ClassName}Po> pos) {
        if (GutilObject.isNotEmpty(pos)) {
            List<${ClassName}DetailVo> list = ListUtil.list(false);
            for (${ClassName}Po po : pos) {
                list.add(fromPo(po));
            }
            return list;
        }
        return ListUtil.empty();
    }

}
