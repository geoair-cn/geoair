<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>
    <groupId>cn.geoair.dependencies</groupId>
    <artifactId>geoair-dependencies-parent</artifactId>
    <name>geoair-dependencies-parent</name>
    <version>23.0.3-SNAPSHOT</version>
    <packaging>pom</packaging>
    <description>用于工程模块的依赖定义</description>

    <properties>
        <geoair.version>${project.version}</geoair.version>
        <geoair.comp.version>${project.version}</geoair.comp.version>
        <skipTests>true</skipTests>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>cn.geoair.dependencies</groupId>
                <artifactId>geoair-base-parent</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>

    </dependencyManagement>


    <modules>
        <module>geoair-api-parent</module>
        <module>geoair-comp-parent</module>
        <module>geoair-project-parent</module>
        <module>geoair-spring-boot-starter-parent</module>
    </modules>



</project>
