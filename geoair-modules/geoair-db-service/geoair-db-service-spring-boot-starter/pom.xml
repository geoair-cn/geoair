  <groupId>cn.geoair.devkit</groupId>
  <artifactId>geoair-db-service-spring-boot-starter</artifactId>
  <version>J8.1.4</version>
  <packaging>jar</packaging>
  <name>geoair-db-service-spring-boot-starter</name>

  <description>geoair-db-service-spring-boot-starter</description>

  <url>https://github.com/geoair-cn/geoair</url>

  <licenses>
    <license>
      <name>The Apache Software License, cn.geoair.map.dynamic.tools.Version 2.0</name>
