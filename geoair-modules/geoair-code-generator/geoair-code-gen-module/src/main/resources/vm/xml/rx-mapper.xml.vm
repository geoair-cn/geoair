<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="${packageName}.${ormPackge}.${moduleName}.${ClassName}Mapper">

    <sql id="tableName">
        ${tableName}
    </sql>
    <sql id="condition">
#foreach($column in $columns)
#if($column.javaType=='Long')
                <if test="param.$column.javaField != null">
                    AND ${tableName}.$column.columnName = #{param.$column.javaField}
                </if>
#end
#if($column.javaType=='Integer')
                <if test="param.$column.javaField != null">
                    AND ${tableName}.$column.columnName = #{param.$column.javaField}
                </if>
#end
#if($column.javaType=='String')
                <if test="param.$column.javaField != null and param.$column.javaField != ''">
                    AND ${tableName}.$column.columnName = #{param.$column.javaField}
                </if>
#end
#if($column.javaType=='Date')
                <if test="param.${column.javaField}Start != null">
                    AND ${tableName}.$column.columnName <![CDATA[>=]]>  #{param.${column.javaField}Start,jdbcType=TIMESTAMP}
                </if>
               <if test="param.${column.javaField}End != null">
                    AND ${tableName}.$column.columnName <![CDATA[<=]]> #{param.${column.javaField}End,jdbcType=TIMESTAMP}
               </if>
#end
#end

        <if test="param.andQueryContentIn != null and param.andQueryContentIn.length > 0">
            AND (
            <foreach collection="param.andQueryContentIn" item="str" index="index"   >
                ${tableName}::text ||'' LIKE '%'|| #{str}||'%'    or
            </foreach>
            1!=1 )
        </if>

#foreach ($column in $columns)
#if($column.isPk==1)
                <if test="param.andIdsIn != null and param.andIdsIn.length > 0">
                    AND ${tableName}.$column.columnName IN
                    <foreach collection="param.andIdsIn" item="id" index="index" open="(" close=")" separator=",">
                        #{id}
                    </foreach>
                </if>

                <if test="param.andIdsNotIn != null and param.andIdsNotIn.length > 0 ">
                    AND ${tableName}.$column.columnName NOT IN
                    <foreach collection="param.andIdsNotIn" item="id" index="index" open="(" close=")" separator=",">
                        #{id}
                    </foreach>
                </if>
    #break
#end
#end

    </sql>


    <sql id="fieldList">
 #foreach ($column in $columns)
#if($column.isPk==1)
#else
                ${tableName}.$column.columnName,
#end
#end
#foreach ($column in $columns)
#if($column.isPk==1)
                ${tableName}.$column.columnName
#end
#end
    </sql>
    <select id="searchList" resultType="${packageName}.model.${moduleName}.dto.${ClassName}Dto">
        SELECT * FROM  <include refid="tableName"></include>
        <where>
            1 = 1
            <include refid="condition"></include>
        </where>
    </select>

</mapper>
