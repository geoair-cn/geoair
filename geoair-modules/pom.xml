<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <parent>
       <groupId>cn.geoair</groupId>
        <artifactId>geoair-base-parent</artifactId>
        <version>J8.1.0-SNAPSHOT</version>
        <relativePath>../geoair-base-parent</relativePath>
    </parent>

   <groupId>cn.geoair</groupId>
    <artifactId>geoair-modules</artifactId>
    <version>J8.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>geoair-modules</name>

    <description>geoair 组件库</description>

    <url>https://gitee.com/geoair/geoair</url>

    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>zhangfengji</name>
            <email>1159856928@qq.com</email>
            <organization>geoair</organization>
            <organizationUrl>https://xmt.geoair.cn/</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://gitee.com/geoair/geoair.git</connection>
        <developerConnection>scm:git:git@gitee.com:geoair/geoair.git</developerConnection>
        <url>https://gitee.com/geoair/geoair</url>
        <tag>HEAD</tag>
    </scm>


    <properties>
        <skipTests>true</skipTests>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
               <groupId>cn.geoair</groupId>
                <artifactId>geoair-standard</artifactId>
                <version>${geoair.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
               <groupId>cn.geoair</groupId>
                <artifactId>geoair-knife4j-springfox-spring-boot-starter</artifactId>
                <version>${geoair.version}</version>
            </dependency>
            <dependency>
               <groupId>cn.geoair</groupId>
                <artifactId>geoair-knife4j-springdoc-spring-boot-starter</artifactId>
                <version>${geoair.version}</version>
            </dependency>

            <dependency>
               <groupId>cn.geoair</groupId>
                <artifactId>geoair-code-gen-module</artifactId>
                <version>${geoair.version}</version>
            </dependency>
            <dependency>
               <groupId>cn.geoair</groupId>
                <artifactId>geoair-message-jts-jackson</artifactId>
                <version>${geoair.version}</version>
            </dependency>
            <dependency>
               <groupId>cn.geoair</groupId>
                <artifactId>geoair-message-jts-mybatis</artifactId>
                <version>${geoair.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>geoair-apidoc</module>
        <module>geoair-code-generator</module>
        <module>geoair-geo</module>
        <module>geoair-dynamic-ds</module>
        <module>geoair-db-service</module>
        <module>geoair-message-converter</module>

    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
