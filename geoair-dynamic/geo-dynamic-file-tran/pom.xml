<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.geoair.geo.dynamic</groupId>
        <artifactId>geoair-dynamic</artifactId>
        <version>23.1.1-M1</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <groupId>cn.geoair.geo.dynamic</groupId>
    <version>23.1.1-M1</version>
    <artifactId>geo-dynamic-file-tran</artifactId>
    <name>geo-dynamic-file-tran</name>


    <packaging>pom</packaging>
    <description>
        geo-dynamic-file-tran
        文件与数据库的转换支持包,基于geotools实现
    </description>

    <url>https://gitee.com/geoair/geo-dynamic</url>

    <licenses>
        <license>
            <name>The Apache Software License, cn.geoair.map.dynamic.tools.Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>zhangfengji</name>
            <email>1159856928@qq.com</email>
            <organization>geoair</organization>
            <organizationUrl>https://xmt.geoair.cn/</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>https://gitee.com/geoair/geo-dynamic.git</connection>
        <developerConnection>scm:git:ssh://git@gitee.com:geoair/geo-dynamic.git</developerConnection>
        <url>https://gitee.com/geoair/geo-dynamic</url>
    </scm>

    <modules>
        <module>geo-dynamic-file-core</module>
        <module>geo-dynamic-file-geojson</module>
        <module>geo-dynamic-file-postgis</module>
        <module>geo-dynamic-file-test</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>cn.geoair.geo.dynamic</groupId>
                <artifactId>geo-dynamic-file-core</artifactId>
                <version>${geoair.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.geoair.geo.dynamic</groupId>
                <artifactId>geo-dynamic-file-geojson</artifactId>
                <version>${geoair.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.geoair.geo.dynamic</groupId>
                <artifactId>geo-dynamic-file-postgis</artifactId>
                <version>${geoair.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>8</source>
                    <target>8</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
