    <properties>
        <skipTests>true</skipTests>
        <geoair.version>J17.1.0-SNAPSHOT</geoair.version>
        <java.version>17</java.version>
        <okhttp.version>4.12.0</okhttp.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.build.timestamp.format>yyyy-MM-dd-HH-mm-ss</maven.build.timestamp.format>
        <ojdbc.version>23.7.0.25.01</ojdbc.version>
        <sdoutl.version>23.26</sdoutl.version>
        <redisson.version>3.52.0</redisson.version>
        <sa-token-version>1.44.0</sa-token-version>
        <tomcat.version>10.1.53</tomcat.version>
        <spring-boot.version>3.5.13</spring-boot.version>
        <spring-data.jpa.version>3.5.10</spring-data.jpa.version>
        <fastjson.version>2.0.61</fastjson.version>
        <dom4j.version>1.6.1</dom4j.version>
        <net.postgis.version>2025.1.1</net.postgis.version>
        <org.postgis.version>1.3.3</org.postgis.version>
        <druid.version>1.2.28</druid.version>
        <mapper-module.version>5.0.2</mapper-module.version>
        <geotools.version>34.3</geotools.version>
        <geoserver.version>2.22.6</geoserver.version>
        <!--        <postgis.jdbc.version>1.3.3</postgis.jdbc.version>-->
        <mybatis-plus.version>3.5.9</mybatis-plus.version>
        <hutool.version>5.8.44</hutool.version>
        <jts.version>1.20.0</jts.version>
        <ecc.vectortile.version>1.3.9</ecc.vectortile.version>
        <proj4j.version>1.3.0</proj4j.version>
        <spring-javaformat.version>0.0.28</spring-javaformat.version>

        <spring.version>6.2.17</spring.version>
        <reflections.version>0.10.2</reflections.version>
        <mybatis.version>3.5.16</mybatis.version>
        <mybatis-spring-boot.version>2.2.2</mybatis-spring-boot.version>
        <mybatis-spring.version>2.0.7</mybatis-spring.version>
        <pagehelper.version>5.3.2</pagehelper.version>
        <lombok.version>1.18.44</lombok.version>
        <fastjson1x.version>2.0.61</fastjson1x.version>


        <!--        <jackson.version>2.15.2</jackson.version>-->
        <gson.version>2.13.2</gson.version>
        <!--        <javax-persistence.version>2.2</javax-persistence.version>-->
        <!--        <javax-cache.version>1.1.1</javax-cache.version>-->
        <!--        <javax-annotation.version>1.3.2</javax-annotation.version>-->
        <jakarta-persistence.version>3.1.0</jakarta-persistence.version>
        <jakarta-servlet.version>6.0.0</jakarta-servlet.version>
        <jakarta-annotation.version>2.1.1</jakarta-annotation.version>
        <jakarta-servlet-jsp-jstl.version>3.0.2</jakarta-servlet-jsp-jstl.version>
        <javax-cache.version>1.1.1</javax-cache.version>
        <!-- Jackson 子版本（基于统一的jackson.version） -->
        <jackson.version>2.21.2</jackson.version>
        <jackson.version.annotations>2.21</jackson.version.annotations>
        <jackson.version.core>${jackson.version}</jackson.version.core>
        <jackson.version.databind>${jackson.version}</jackson.version.databind>
        <jackson.version.dataformat>${jackson.version}</jackson.version.dataformat>
        <jackson.version.datatype>${jackson.version}</jackson.version.datatype>
        <jackson.version.jaxrs>${jackson.version}</jackson.version.jaxrs>
        <jackson.version.jakarta.rs>${jackson.version}</jackson.version.jakarta.rs>
        <jackson.version.jacksonjr>${jackson.version}</jackson.version.jacksonjr>

        <postgresql.version>42.7.10</postgresql.version>
        <jedis.version>6.0.0</jedis.version>
        <hibernate.version>6.6.45.Final</hibernate.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>

        <jakarta-servlet.version>6.0.0</jakarta-servlet.version>

        <springfox.version>3.0.0</springfox.version>
        <springdoc.version>2.8.16</springdoc.version>
        <knife4j-openapi3.version>4.5.0</knife4j-openapi3.version>
        <knife4j.openapi2.version>3.0.3</knife4j.openapi2.version>

        <maven-compiler-plugin.version>3.14.1</maven-compiler-plugin.version>

        <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.11.3</maven-javadoc-plugin.version>
        <git-commit-id-plugin.version>4.9.10</git-commit-id-plugin.version>
        <maven-dependency-plugin.version>3.8.1</maven-dependency-plugin.version>
        <fmt-maven-plugin.version>2.29</fmt-maven-plugin.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>pl.project13.maven</groupId>
                    <artifactId>git-commit-id-plugin</artifactId>
                    <version>${git-commit-id-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>get-the-git-infos</id>
                            <phase>initialize</phase>
                            <goals>
                                <goal>revision</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <generateGitPropertiesFile>true</generateGitPropertiesFile>
                        <generateGitPropertiesFilename>${project.build.outputDirectory}/git.properties
                        </generateGitPropertiesFilename>

                        <!-- 包含提交信息相关属性（关键） -->
                        <includeOnlyProperties>
                            <includeOnlyProperty>^git.commit.id$</includeOnlyProperty>
                            <!-- 完整提交哈希 -->
                            <includeOnlyProperty>^git.commit.time$</includeOnlyProperty>
                            <!-- 提交时间 -->
                            <includeOnlyProperty>^git.commit.message.full$</includeOnlyProperty>
                            <!-- 完整提交信息 -->
                            <includeOnlyProperty>^git.commit.message.short$</includeOnlyProperty>
                            <!-- 提交标题（第一行） -->
                            <includeOnlyProperty>^git.branch$</includeOnlyProperty>
                            <!-- 提交标题（第一行） -->
                        </includeOnlyProperties>

                        <dateFormat>yyyy-MM-dd HH:mm:ss</dateFormat>
                        <dateFormatTimeZone>Asia/Shanghai</dateFormatTimeZone>
                        <verbose>false</verbose>
                        <skipPoms>true</skipPoms>
                    </configuration>
                </plugin>


                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>${maven-source-plugin.version}</version>
                    <executions>
                        <execution>
                            <phase>compile</phase>
                            <goals>
                                <goal>jar-no-fork</goal>
                            </goals>
                            <configuration>
                                <attach>true</attach>
                                <classifier>sources</classifier>  <!-- 相同的 classifier！ -->
                            </configuration>
                        </execution>
                    </executions>
                    <configuration>
                        <attach>true</attach>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <parameters>true</parameters>
                        <!-- 源码版本 -->
                        <source>17</source>
                        <!-- 目标字节码版本 -->
                        <target>17</target>
                        <!-- 编码（可选，避免中文乱码） -->
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${maven-javadoc-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>attach-javadocs</id>
                            <goals>
                                <!-- 打包 javadoc.jar -->
                                <goal>jar</goal>
                                <!-- 编译时自动修复注释 -->
                                <goal>fix</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <!-- 自动修复类注释 -->
                        <fixClassComment>true</fixClassComment>
                        <!-- 自动修复方法注释 -->
                        <fixMethodComment>true</fixMethodComment>
                        <!-- 自动修复字段注释 -->
                        <fixFieldComment>true</fixFieldComment>
                        <version>false</version>
                        <author>false</author>
                        <!-- 开启严格模式，注释不规范直接报错 -->
                        <failOnError>false</failOnError>
                        <!-- 文档编码 UTF-8 -->
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>1.5</version>
                    <executions>
                        <execution>
                            <id>sign-artifacts</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>sign</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>0.9.0</version>
                    <extensions>true</extensions>
                    <configuration>
                        <publishingServerId>central</publishingServerId>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>net.revelc.code</groupId>
                    <artifactId>impsort-maven-plugin</artifactId>
                    <version>1.13.0</version>
                    <executions>
                        <execution>
                            <id>sort-imports</id>
                            <goals>
                                <goal>sort</goal>
                                <!-- runs at process-sources phase by default -->
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <groups>*</groups>
                        <!-- 静态导入也统一规则 -->
                        <staticGroups>*</staticGroups>
                        <!-- 保留：自动删除没用的 import -->
                        <removeUnused>true</removeUnused>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>4.9.8.2</version>
                    <!-- Java8 最后稳定版 -->
                    <executions>
                        <execution>
                            <goals>
                                <goal>check</goal>
                                <!-- 构建时自动检查 -->
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <encoding>UTF-8</encoding>
                        <failOnError>false</failOnError>
                        <!-- 发现bug是否让构建失败 -->
                        <includeTests>false</includeTests>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.gaul</groupId>
                    <artifactId>modernizer-maven-plugin</artifactId>
                    <version>3.3.0</version>
                    <!-- Java8 稳定版 -->
                    <executions>
                        <execution>
                            <goals>
                                <goal>modernizer</goal>
                                <!-- 构建时自动检查 -->
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <!-- Java 版本（你是8就填8） -->
                        <javaVersion>17</javaVersion>
                        <!-- 发现问题是否让构建失败（企业一般设为false，只提醒） -->
                        <failOnViolations>false</failOnViolations>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.github.ekryd.sortpom</groupId>
                    <artifactId>sortpom-maven-plugin</artifactId>
                    <version>4.0.0</version>
                    <executions>
                        <execution>
                            <phase>verify</phase>
                            <goals>
                                <goal>sort</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <skip>false</skip>
                        <keepBlankLines>true</keepBlankLines>
                        <sortDependencies>''</sortDependencies>
                        <spaceBeforeCloseEmptyElement>false</spaceBeforeCloseEmptyElement>
                        <createBackupFile>false</createBackupFile>
                        <verifyFail>stop</verifyFail>
                        <verifyFailOn>strict</verifyFailOn>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>com.spotify.fmt</groupId>
                    <artifactId>fmt-maven-plugin</artifactId>
                    <version>${fmt-maven-plugin.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>format</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <verbose>false</verbose>
                        <filesNamePattern>.*\.java</filesNamePattern>
                        <skip>false</skip>
                        <style>aosp</style>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
            </plugin>

            <!--生成源码插件-->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>

            <!--生成API文档插件-->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven-javadoc-plugin.version}</version>
            </plugin>
        </plugins>

    </build>
    <profiles>
        <profile>
            <id>central</id>
            <build>
                <!--发布到中央SNAPSHOT仓库插件-->
                <plugins>
                    <!--gpg插件-->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.9.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
            <distributionManagement>
                <repository>
                    <id>ossrh</id>
                    <url>https://central.sonatype.com/repository/maven-snapshots/</url>
                </repository>
                <snapshotRepository>
                    <id>ossrh</id>
                    <url>https://central.sonatype.com/repository/maven-snapshots/</url>
                </snapshotRepository>
            </distributionManagement>
        </profile>
        <profile>
            <id>code-style</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.spotify.fmt</groupId>
                        <artifactId>fmt-maven-plugin</artifactId>
                        <version>${fmt-maven-plugin.version}</version>
                    </plugin>

                    <plugin>
                        <groupId>com.github.ekryd.sortpom</groupId>
                        <artifactId>sortpom-maven-plugin</artifactId>
                        <version>4.0.0</version>

                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>code-check</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-maven-plugin</artifactId>
                        <version>4.9.8.2</version>

                    </plugin>
                    <plugin>
                        <groupId>org.gaul</groupId>
                        <artifactId>modernizer-maven-plugin</artifactId>
                        <version>3.3.0</version>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>${maven-dependency-plugin.version}</version>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>geoair-group-repo</id>
            <distributionManagement>
                <repository>
                    <id>gir-release</id>
                    <url>http://xmt.geoair.cn:32000/repository/109-release/</url>
                </repository>
                <snapshotRepository>
                    <id>gir-snapshot</id>
                    <url>http://xmt.geoair.cn:32000/repository/109-snapshot/</url>
                </snapshotRepository>
            </distributionManagement>
        </profile>
        <profile>
            <id>git-commit-id-gen</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>pl.project13.maven</groupId>
                        <artifactId>git-commit-id-plugin</artifactId>
                    </plugin>

                </plugins>
            </build>
        </profile>
    </profiles>
</project>
