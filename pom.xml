    <developers>
        <developer>
            <name>张逢吉</name>
            <email>1159856928@qq.com</email>
            <organization>geoair</organization>
            <organizationUrl>https://xmt.geoair.cn/</organizationUrl>
        </developer>
    </developers>

    <modules>
        <module>geoair-dependencies-bom</module>
        <module>geoair-base-parent</module>
        <module>geoair-framework-bom</module>
        <module>geoair-standard</module>
        <module>geoair-modules</module>
